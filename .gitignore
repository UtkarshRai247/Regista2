# Ignore everything under data/ except the one frozen metric output
# (a plain "data/" pattern would stop git descending into it at all,
# making the nested negation below silently do nothing — data/* avoids
# that gotcha).
data/*
!data/processed/
data/processed/*
!data/processed/player_season_metrics.parquet
!data/splits/
data/splits/*
!data/splits/match_split.csv
!data/splits/cv_folds.csv
*.ckpt
*.pt
*.pth
*.h5
*.safetensors
__pycache__/
*.pyc
.DS_Store
.venv/
venv/
